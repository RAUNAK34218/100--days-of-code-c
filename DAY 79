#include <stdio.h>

int main() {
    FILE *fp = fopen("numbers.txt", "r");
    if (fp == NULL) { printf("File not found.\n"); return 1; }
    int x, count = 0, sum = 0;
    while (fscanf(fp, "%d", &x) == 1) {
        sum += x;
        count++;
    }
    fclose(fp);
    if (count > 0)
        printf("Sum = %d\nAverage = %.2f\n", sum, (float)sum / count);
    else
        printf("No numbers found.\n");
    return 0;
}
