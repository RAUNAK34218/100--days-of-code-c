#include <stdio.h>

enum Role { ADMIN, USER, GUEST };

int main() {
    enum Role r;
    printf("Enter role (0=ADMIN, 1=USER, 2=GUEST): ");
    scanf("%d", (int *)&r);
    switch (r) {
        case ADMIN: printf("Welcome Admin! Full access.\n");   break;
        case USER:  printf("Welcome User! Limited access.\n"); break;
        case GUEST: printf("Welcome Guest! Read-only access.\n"); break;
        default:    printf("Invalid role\n");
    }
    return 0;
}
