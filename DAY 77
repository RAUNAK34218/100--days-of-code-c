#include <stdio.h>
#include <ctype.h>

int main() {
    FILE *in = fopen("input.txt", "r");
    if (in == NULL) { printf("input.txt not found.\n"); return 1; }
    FILE *out = fopen("output.txt", "w");
    int c;
    while ((c = fgetc(in)) != EOF)
        fputc(toupper(c), out);
    fclose(in);
    fclose(out);
    printf("Done.\n");
    return 0;
}
